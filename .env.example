# Скопируйте этот файл в `.env` для локальной разработки.
COMPOSE_PROJECT_NAME=ai-workspace

# MWS GPT
MWS_GPT_BASE_URL=https://api.llmops.mts-corp.ru/v1
MWS_GPT_API_KEY=

DEFAULT_TEXT_MODEL=gpt-4o-mini
FALLBACK_TEXT_MODEL=cotype-pro
VISION_MODEL=gpt-4o
VISION_FALLBACK_MODEL=qwen2.5-vl-32b-instruct-awq
ASR_MODEL=whisper-turbo-local-preview
IMAGE_GENERATION_MODEL=sd3.5-large-image
IMAGE_GENERATION_FALLBACK_MODEL=sdxl-lightning-image
EMBEDDING_MODEL=bge-m3

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:main

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_RELOAD=true

# Database
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DSN=postgresql+asyncpg://postgres:change_me@postgres:5432/postgres

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio
MINIO_BUCKET=gpthub

# OpenWebUI → Backend gateway
OPENWEBUI_API_BASE_URL=http://backend:8000/v1
OPENWEBUI_API_KEY=local-dev-key
